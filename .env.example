# ==============================================================================
# CodeOrbit Tech - Task 4: Secure User Authentication Environment Configuration
# ==============================================================================
# Copy this file to .env and customize for your local or production environment.
# DO NOT commit your actual .env file with production secrets to version control!

# Port the Express HTTP server should listen on
PORT=3000

# Environment mode: 'development' or 'production'
# In production, secure cookies (HTTPS) and strict caching policies are enforced.
NODE_ENV=development

# Session Secret: A cryptographically strong, random string (minimum 32 characters)
# used to sign the session ID cookie and prevent cookie tampering.
#
# HOW TO GENERATE A STRONG SESSION SECRET:
# Run the following command in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Paste the resulting 64-character hexadecimal string below:
SESSION_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
